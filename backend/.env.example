PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=rkap_db

# Wajib diisi! Kunci rahasia untuk sesi express-session (minimal 32 karakter acak)
SESSION_SECRET=your_random_session_secret_here

# Origin frontend yang diizinkan untuk CORS (pisahkan dengan koma bila lebih dari satu)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Variabel Lingkungan untuk Skrip Bootstrap Akuntansi Pertama (Fase 8)
# Dijalankan via: npm run bootstrap-admin
INITIAL_ACCOUNTANT_NAME=Admin Akuntansi
INITIAL_ACCOUNTANT_EMAIL=akuntansi@ciptanirmala.com
INITIAL_ACCOUNTANT_PASSWORD=your_secure_password_here
